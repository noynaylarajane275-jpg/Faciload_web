{
  "name": "faciload",
  "version": "0.1.0",
  "private": true,
  "description": "FACILOAD — Industrial Engineering Faculty Workload Management System",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run dev --workspace apps/api",
    "dev:web": "npm run dev --workspace apps/web",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "migrate:dev": "npm run migrate:dev --workspace apps/api",
    "seed": "npm run seed --workspace apps/api",
    "share": "share.bat",
    "share:selftest": "share.bat /selftest"
  },
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "bcrypt@5.1.1": true,
    "esbuild@0.28.2": true,
    "esbuild@0.21.5": true,
    "prisma@6.19.3": true,
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true
  }
}
