# Copy to .env for local development:
#   copy .env.example .env   (Windows)
#
# See repo-root .env.example / README.md for what each variable is for.

# Database: SQLite — no connection string needed. The path lives in
# prisma/schema.prisma (provider "sqlite", url "file:./dev.db") and resolves
# to apps/api/prisma/dev.db. PostgreSQL remains the production target (docs/4-database.md).
JWT_SECRET="dev-only-change-me-access-secret"
JWT_REFRESH_SECRET="dev-only-change-me-refresh-secret"
PORT="4000"
CORS_ORIGIN="http://localhost:5173"

# File storage (tech-stack.md): LOCAL in development, S3/MinIO in production.
# UPLOAD_DIR overrides where avatar uploads are written (default: apps/api/uploads).
# FILE_STORAGE=local|s3 — the S3 driver is planned for the exports worker phase.
FILE_STORAGE="local"
