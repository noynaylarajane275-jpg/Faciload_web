# Dependencies
node_modules/

# Builds
dist/
build/
.vite/
*.tsbuildinfo

# Env (never commit real secrets)
.env
.env.local
apps/api/.env
apps/web/.env

# Prisma (generated client only — migrations are committed)
apps/api/node_modules/.prisma

# SQLite local dev database (regenerated by `prisma migrate dev` + `npm run seed`)
*.db
*.db-journal
*.db-wal
*.db-shm

# share.bat snapshot of dev.db (restore by copying it back over dev.db)
apps/api/prisma/dev.share-backup.db


# Logs / OS
npm-debug.log*
*.log
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
