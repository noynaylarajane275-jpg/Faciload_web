# Copy to .env at repo root (or per-app .env) for local development:
#   copy .env.example .env        (Windows)
#   cp .env.example .env          (macOS/Linux)
#
# Variables are read by apps/api via dotenv.

# Database: SQLite — no connection string needed. The path lives in
# apps/api/prisma/schema.prisma (provider "sqlite", url "file:./dev.db") and
# resolves to apps/api/prisma/dev.db. PostgreSQL remains the production target (docs/4-database.md).

# Secret used to sign short-lived access JWTs (Phase 2 auth).
JWT_SECRET="dev-only-change-me-access-secret"

# Secret used to sign long-lived refresh JWTs (Phase 2 auth).
JWT_REFRESH_SECRET="dev-only-change-me-refresh-secret"

# Port the Express API listens on.
PORT="4000"

# Allowed browser origin for CORS (Vite dev server).
CORS_ORIGIN="http://localhost:5173"
